# Connection details for the database used in the exercise notebook.
# Copy this file to a new .env file and fill in the real values. Never commit .env.

DATABASE=<your-database-name>
USER_DB=<your-username>
PASSWORD=<your-password>
HOST=<your-host>
PORT=5432

# Full SQLAlchemy connection string (used by 2_exercise_machine_learning.ipynb)
DB_STRING=postgresql://<your-username>:<your-password>@<your-host>:5432/<your-database-name>
